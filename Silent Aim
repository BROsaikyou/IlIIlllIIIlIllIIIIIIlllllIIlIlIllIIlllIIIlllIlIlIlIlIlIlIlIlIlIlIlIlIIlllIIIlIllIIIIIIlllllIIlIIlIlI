local function GetTargetsInRange(character, range)
    local myPos = character:GetPivot().Position
    local targetList = {}
    
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, enemy in ipairs(enemies:GetChildren()) do
            local enemyHRP = enemy:FindFirstChild("HumanoidRootPart")
            if enemyHRP and IsAliveTarget(enemy) and (enemyHRP.Position - myPos).Magnitude <= range then
                table.insert(targetList, enemy)
            end
        end
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local playerHRP = player.Character:FindFirstChild("HumanoidRootPart")
            if playerHRP and IsAliveTarget(player.Character) and (playerHRP.Position - myPos).Magnitude <= range then
                table.insert(targetList, player.Character)
            end
        end
    end
    return targetList
end

local function ExecuteAttack()
    local myChar = localPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    
    local tool = nil
    for _, child in ipairs(myChar:GetChildren()) do
        if child:IsA("Tool") then tool = child; break end
    end
    if not tool then return end
    
    vu43 = (myHRP:FindFirstChild("Buddha") and vu44) and 50000 or 60
    local targetList = GetTargetsInRange(myChar, vu43)
    
    if tool:FindFirstChild("LeftClickRemote") then
        for count, target in ipairs(targetList) do
            local targetHRP = target:FindFirstChild("HumanoidRootPart")
            if targetHRP then
                local direction = (targetHRP.Position - myChar:GetPivot().Position).Unit
                tool.LeftClickRemote:FireServer(direction, count)
            end
        end
    else
        local hitList = {}
        local lastHead = nil
        for _, target in ipairs(targetList) do
            if not target:GetAttribute("IsBoat") then
                local head = target:FindFirstChild("Head")
                if head then table.insert(hitList, {target, head}); lastHead = head end
            end
        end
        
        if lastHead then
            local modules = ReplicatedStorage:FindFirstChild("Modules")
            local net = modules and modules:FindFirstChild("Net")
            if net then
                local registerAttack = net:FindFirstChild("RE/RegisterAttack")
                local registerHit = net:FindFirstChild("RE/RegisterHit")
                if registerAttack and registerHit then
                    registerAttack:FireServer(0.4)
                    registerHit:FireServer(lastHead, hitList)
                end
            end
        end
    end
end


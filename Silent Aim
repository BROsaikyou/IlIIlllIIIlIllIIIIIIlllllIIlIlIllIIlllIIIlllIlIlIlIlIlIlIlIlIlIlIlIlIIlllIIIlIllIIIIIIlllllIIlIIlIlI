local AutoAttackEnabled = true 
local Remotes = {}

local function CollectRemotes()
    local char = localPlayer.Character
    if not char then return end

    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("RemoteEvent") and v.Name == "LeftClickRemote" then
            Remotes[v] = true
        end
    end

    local backpack = localPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, v in ipairs(backpack:GetDescendants()) do
            if v:IsA("RemoteEvent") and v.Name == "LeftClickRemote" then
                Remotes[v] = true
            end
        end
    end
end

local function GetNearestTargetForM1()
    local char = localPlayer.Character
    if not char then return nil end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local nearest = nil
    local shortest = math.huge

    local targets = {}
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and plr.Character then
            table.insert(targets, plr.Character)
        end
    end

    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, v in ipairs(enemiesFolder:GetChildren()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
                table.insert(targets, v)
            end
        end
    end

    for _, targetChar in ipairs(targets) do
        local eh = targetChar:FindFirstChild("Humanoid")
        local ehrp = targetChar:FindFirstChild("HumanoidRootPart")

        if eh and ehrp and eh.Health > 0 then
            local dist = (ehrp.Position - hrp.Position).Magnitude
            if dist < shortest then
                shortest = dist
                nearest = ehrp
            end
        end
    end

    return nearest
end

local function SpamClick()
    CollectRemotes()
    
    local char = localPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local direction
    local target = GetNearestTargetForM1()
    if target then
        direction = (target.Position - hrp.Position).Unit
    else
        direction = hrp.CFrame.LookVector
    end

    for remote in pairs(Remotes) do
        if remote and remote.Parent then
            pcall(function()
                remote:FireServer(direction, 1)
            end)
        else
            Remotes[remote] = nil 
        end
    end
end


	CloseBtn.TextSize = 18
	CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	CloseBtn.Font = Enum.Font.GothamBold
	CloseBtn.Parent = Header

	local CloseCorner = Instance.new("UICorner")
	CloseCorner.CornerRadius = UDim.new(0, 6)
	CloseCorner.Parent = CloseBtn

	CloseBtn.MouseButton1Click:Connect(function()
		ScreenGui:Destroy()
	end)

	local isMinimized = false

	-- 最小化ボタン
	local MinimizeBtn = Instance.new("TextButton")
	MinimizeBtn.Size = UDim2.new(0, 26, 0, 26)
	MinimizeBtn.Position = UDim2.new(1, -66, 0.5, -13)
	MinimizeBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
	MinimizeBtn.Text = "-"
	MinimizeBtn.TextSize = 18
	MinimizeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	MinimizeBtn.Font = Enum.Font.GothamBold
	MinimizeBtn.Parent = Header

	local MinCorner = Instance.new("UICorner")
	MinCorner.CornerRadius = UDim.new(0, 6)
	MinCorner.Parent = MinimizeBtn

	-- スクロールエリア
	local ScrollingFrame = Instance.new("ScrollingFrame")
	ScrollingFrame.Size = UDim2.new(1, -16, 1, -52)
	ScrollingFrame.Position = UDim2.new(0, 8, 0, 48)
	ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	ScrollingFrame.ScrollBarThickness = 4
	ScrollingFrame.ScrollBarImageColor3 = Color3.fromRGB(100, 100, 110)
	ScrollingFrame.BackgroundTransparency = 1
	ScrollingFrame.BorderSizePixel = 0
	ScrollingFrame.Parent = MainFrame

	local UIListLayout = Instance.new("UIListLayout")
	UIListLayout.Padding = UDim.new(0, 6)
	UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	UIListLayout.Parent = ScrollingFrame

	UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
	end)

	MinimizeBtn.MouseButton1Click:Connect(function()
		isMinimized = not isMinimized
		local targetHeight = isMinimized and 42 or PANEL_HEIGHT
		MinimizeBtn.Text = isMinimized and "+" or "-"
		HeaderBottomFix.Visible = not isMinimized

		TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, PANEL_WIDTH, 0, targetHeight)
		}):Play()
		ScrollingFrame.Visible = not isMinimized
	end)

	local function IsInSafeZone(targetPlayer)
		if not (targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")) then return false end
		local hrp = targetPlayer.Character.HumanoidRootPart
		local safeZones = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("SafeZones")
		if not safeZones then return false end
		for _, zone in ipairs(safeZones:GetChildren()) do
			local mesh = zone:FindFirstChild("Mesh")
			if mesh then
				local dist = (hrp.Position - zone.Position).Magnitude
				if dist <= (zone.Size.X * mesh.Scale.X / 2) then return true end
			end
		end
		return false
	end

	local lastPositions = {}
	local playerUIs = {}

	local function CreatePlayerItem(p)
		local item = Instance.new("Frame")
		item.Size = UDim2.new(1, 0, 0, 80)
		item.BorderSizePixel = 0
		item.Parent = ScrollingFrame

		local itemCorner = Instance.new("UICorner")
		itemCorner.CornerRadius = UDim.new(0, 6)
		itemCorner.Parent = item

		-- アバターアイコン
		local avatarImg = Instance.new("ImageLabel")
		avatarImg.Size = UDim2.new(0, 36, 0, 36)
		avatarImg.Position = UDim2.new(0, 8, 0, 8)
		avatarImg.BackgroundTransparency = 1
		avatarImg.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150", p.UserId)
		avatarImg.Parent = item

		local imgCorner = Instance.new("UICorner")
		imgCorner.CornerRadius = UDim.new(1, 0)
		imgCorner.Parent = avatarImg

		-- 表示名 (名前の横にレベルを表示するため少し広め確保)
		local displayNameLabel = Instance.new("TextLabel")
		displayNameLabel.Size = UDim2.new(1, -135, 0, 18)
		displayNameLabel.Position = UDim2.new(0, 50, 0, 6)
		displayNameLabel.BackgroundTransparency = 1
		displayNameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		displayNameLabel.TextSize = 13
		displayNameLabel.Font = Enum.Font.GothamBold
		displayNameLabel.TextXAlignment = Enum.TextXAlignment.Left
		displayNameLabel.TextTruncate = Enum.TextTruncate.AtEnd
		displayNameLabel.Parent = item

		-- ユーザー名
		local usernameLabel = Instance.new("TextLabel")
		usernameLabel.Size = UDim2.new(1, -135, 0, 16)
		usernameLabel.Position = UDim2.new(0, 50, 0, 24)
		usernameLabel.BackgroundTransparency = 1
		usernameLabel.TextColor3 = Color3.fromRGB(210, 210, 215)
		usernameLabel.TextSize = 11
		usernameLabel.Font = Enum.Font.Gotham
		usernameLabel.TextXAlignment = Enum.TextXAlignment.Left
		usernameLabel.TextTruncate = Enum.TextTruncate.AtEnd
		usernameLabel.Parent = item

		-- 右上のステータス (PVP: ON / OFF などを表示)
		local rightStatusLabel = Instance.new("TextLabel")
		rightStatusLabel.Size = UDim2.new(0, 115, 0, 34)
		rightStatusLabel.Position = UDim2.new(1, -122, 0, 6)
		rightStatusLabel.BackgroundTransparency = 1
		rightStatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		rightStatusLabel.TextSize = 11
		rightStatusLabel.Font = Enum.Font.GothamBold
		rightStatusLabel.TextXAlignment = Enum.TextXAlignment.Right
		rightStatusLabel.Parent = item

		-- 座標表示
		local coordLabel = Instance.new("TextLabel")
		coordLabel.Size = UDim2.new(1, -16, 0, 16)
		coordLabel.Position = UDim2.new(0, 8, 0, 46)
		coordLabel.BackgroundTransparency = 1
		coordLabel.TextColor3 = Color3.fromRGB(235, 245, 255)
		coordLabel.TextSize = 12
		coordLabel.Font = Enum.Font.GothamMedium
		coordLabel.TextXAlignment = Enum.TextXAlignment.Left
		coordLabel.Parent = item

		-- HPバー
		local healthBarBg = Instance.new("Frame")
		healthBarBg.Size = UDim2.new(1, -16, 0, 5)
		healthBarBg.Position = UDim2.new(0, 8, 1, -10)
		healthBarBg.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
		healthBarBg.BackgroundTransparency = 0.4
		healthBarBg.BorderSizePixel = 0
		healthBarBg.Parent = item

		local bgCorner = Instance.new("UICorner")
		bgCorner.CornerRadius = UDim.new(1, 0)
		bgCorner.Parent = healthBarBg

		local healthBarFill = Instance.new("Frame")
		healthBarFill.Size = UDim2.new(1, 0, 1, 0)
		healthBarFill.BackgroundColor3 = Color3.fromRGB(60, 220, 120)
		healthBarFill.BorderSizePixel = 0
		healthBarFill.Parent = healthBarBg

		local fillCorner = Instance.new("UICorner")
		fillCorner.CornerRadius = UDim.new(1, 0)
		fillCorner.Parent = healthBarFill

		playerUIs[p] = {
			Item = item,
			DisplayName = displayNameLabel,
			Username = usernameLabel,
			RightStatus = rightStatusLabel,
			Coord = coordLabel,
			Fill = healthBarFill
		}
	end

	local function UpdateList()
		local currentPlayers = {}
		for _, p in ipairs(Players:GetPlayers()) do
			currentPlayers[p] = true

			if not playerUIs[p] or not playerUIs[p].Item.Parent then
				CreatePlayerItem(p)
			end

			local ui = playerUIs[p]
			if ui then
				local level = p:FindFirstChild("Data")
					and p.Data:FindFirstChild("Level")
					and p.Data.Level.Value or "?"

				-- 表示名の横にレベルを配置 (例: DisplayName (Lv.10))
				ui.DisplayName.Text = string.format("%s (Lv.%s)", p.DisplayName or p.Name, tostring(level))
				ui.Username.Text = "@" .. p.Name

				local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
				local posText = "X: ---   Y: ---   Z: ---"
				local moving = false

				if hrp then
					local pos = hrp.Position
					posText = string.format("X: %.0f   Y: %.0f   Z: %.0f", pos.X, pos.Y, pos.Z)

					local lastPos = lastPositions[p]
					if lastPos then
						moving = (pos - lastPos).Magnitude > 0.05
					end
					lastPositions[p] = pos
				end
				ui.Coord.Text = posText

				local humanoid = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
				local health = humanoid and math.floor(humanoid.Health) or 0
				local maxHealth = humanoid and math.floor(humanoid.MaxHealth) or 100
				if maxHealth <= 0 then maxHealth = 100 end

				local pvpDisabled = p:GetAttribute("PvpDisabled")
				local safe = IsInSafeZone(p)

				-- ご要望の通り PvP: OFF / PvP: ON 表記に修正
				local pvpText = pvpDisabled and "PVP: OFF" or "PVP: ON"
				ui.RightStatus.Text = string.format("HP: %d/%d\n%s [%s]", health, maxHealth, pvpText, moving and "WALK" or "STOP")

				local healthPercent = math.clamp(health / maxHealth, 0, 1)
				ui.Fill.Size = UDim2.new(healthPercent, 0, 1, 0)

				-- 背景カラー
				if pvpDisabled then
					ui.Item.BackgroundColor3 = Color3.fromRGB(145, 45, 45) -- 赤 (PvP OFF)
				elseif safe then
					ui.Item.BackgroundColor3 = Color3.fromRGB(45, 80, 155)  -- 青 (セーフゾーン)
				else
					ui.Item.BackgroundColor3 = Color3.fromRGB(40, 125, 65)  -- 緑 (通常PvP ON)
				end
			end
		end

		for p, ui in pairs(playerUIs) do
			if not currentPlayers[p] then
				if ui.Item then ui.Item:Destroy() end
				playerUIs[p] = nil
				lastPositions[p] = nil
			end
		end
	end

	local connection
	connection = RunService.Heartbeat:Connect(function()
		if not ScreenGui.Parent then
			connection:Disconnect()
			return
		end
		if not isMinimized then
			UpdateList()
		end
	end)
	UpdateList()
end

CreatePvpList()

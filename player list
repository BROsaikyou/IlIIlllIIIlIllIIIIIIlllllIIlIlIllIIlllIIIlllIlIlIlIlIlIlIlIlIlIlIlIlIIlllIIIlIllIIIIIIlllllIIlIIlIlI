        levelLabel.TextColor3 = Color3.fromRGB(255, 220, 100)
        levelLabel.TextSize = 13
        levelLabel.Font = Enum.Font.GothamBold
        levelLabel.TextXAlignment = Enum.TextXAlignment.Left
        levelLabel.Parent = item

        -- ユーザー名
        local usernameLabel = Instance.new("TextLabel")
        usernameLabel.Size = UDim2.new(0.55, -50, 0, 18)
        usernameLabel.Position = UDim2.new(0, 54, 0, 28)
        usernameLabel.BackgroundTransparency = 1
        usernameLabel.Text = "@" .. p.Name
        usernameLabel.TextColor3 = Color3.fromRGB(210, 210, 215)
        usernameLabel.TextSize = 12
        usernameLabel.Font = Enum.Font.Gotham
        usernameLabel.TextXAlignment = Enum.TextXAlignment.Left
        usernameLabel.TextTruncate = Enum.TextTruncate.AtEnd
        usernameLabel.Parent = item

        -- 座標表示
        local coordLabel = Instance.new("TextLabel")
        coordLabel.Size = UDim2.new(1, -16, 0, 18)
        coordLabel.Position = UDim2.new(0, 8, 0, 50)
        coordLabel.BackgroundTransparency = 1
        coordLabel.TextColor3 = Color3.fromRGB(235, 245, 255)
        coordLabel.TextSize = 13
        coordLabel.Font = Enum.Font.GothamMedium
        coordLabel.TextXAlignment = Enum.TextXAlignment.Left
        coordLabel.Parent = item

        -- ステータス
        local statusLabel = Instance.new("TextLabel")
        statusLabel.Size = UDim2.new(0.42, 0, 0, 42)
        statusLabel.Position = UDim2.new(0.58, 0, 0, 6)
        statusLabel.BackgroundTransparency = 1
        statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        statusLabel.TextSize = 12
        statusLabel.Font = Enum.Font.GothamBold
        statusLabel.TextXAlignment = Enum.TextXAlignment.Right
        statusLabel.Parent = item

        -- HPバー
        local healthBarBg = Instance.new("Frame")
        healthBarBg.Size = UDim2.new(1, -16, 0, 5)
        healthBarBg.Position = UDim2.new(0, 8, 1, -10)
        healthBarBg.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
        healthBarBg.BackgroundTransparency = 0.4
        healthBarBg.BorderSizePixel = 0
        healthBarBg.Parent = item

        local bgCorner = Instance.new("UICorner")
        bgCorner.CornerRadius = UDim.new(1, 0)
        bgCorner.Parent = healthBarBg

        local healthBarFill = Instance.new("Frame")
        healthBarFill.Size = UDim2.new(1, 0, 1, 0)
        healthBarFill.BackgroundColor3 = Color3.fromRGB(60, 220, 120)
        healthBarFill.BorderSizePixel = 0
        healthBarFill.Parent = healthBarBg

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(1, 0)
        fillCorner.Parent = healthBarFill

        playerUIs[p] = {
            Item = item,
            DisplayName = displayNameLabel,
            Level = levelLabel,
            Coord = coordLabel,
            Status = statusLabel,
            Fill = healthBarFill
        }
    end

    local function UpdateList()
        local currentPlayers = {}
        for _, p in ipairs(Players:GetPlayers()) do
            currentPlayers[p] = true

            if not playerUIs[p] or not playerUIs[p].Item.Parent then
                CreatePlayerItem(p)
            end

            local ui = playerUIs[p]
            if ui then
                local level = p:FindFirstChild("Data") 
                    and p.Data:FindFirstChild("Level") 
                    and p.Data.Level.Value or "?"

                ui.DisplayName.Text = p.DisplayName or p.Name
                ui.Level.Text = string.format("(Lv.%s)", tostring(level))

                local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                local posText = "X: ---   Y: ---   Z: ---"
                local moving = false

                if hrp then
                    local pos = hrp.Position
                    posText = string.format("X: %.0f   Y: %.0f   Z: %.0f", pos.X, pos.Y, pos.Z)
                    
                    local lastPos = lastPositions[p]
                    if lastPos then
                        moving = (pos - lastPos).Magnitude > 0.05
                    end
                    lastPositions[p] = pos
                end
                ui.Coord.Text = posText

                local humanoid = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                local health = humanoid and math.floor(humanoid.Health) or 0
                local maxHealth = humanoid and math.floor(humanoid.MaxHealth) or 100
                if maxHealth <= 0 then maxHealth = 100 end

                local pvpDisabled = p:GetAttribute("PvpDisabled")
                local safe = IsInSafeZone(p)

                ui.Status.Text = string.format("HP: %d/%d\n[P:%s] [%s]", health, maxHealth, pvpDisabled and "OFF" or "ON", moving and "WALK" or "STOP")

                local healthPercent = math.clamp(health / maxHealth, 0, 1)
                ui.Fill.Size = UDim2.new(healthPercent, 0, 1, 0)

                if pvpDisabled then
                    ui.Item.BackgroundColor3 = Color3.fromRGB(145, 45, 45)
                elseif safe then
                    ui.Item.BackgroundColor3 = Color3.fromRGB(45, 80, 155)
                else
                    ui.Item.BackgroundColor3 = Color3.fromRGB(40, 125, 65)
                end
            end
        end

        for p, ui in pairs(playerUIs) do
            if not currentPlayers[p] then
                if ui.Item then ui.Item:Destroy() end
                playerUIs[p] = nil
                lastPositions[p] = nil
            end
        end
    end

    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not ScreenGui.Parent then 
            connection:Disconnect() 
            return 
        end
        if not isMinimized then
            UpdateList()
        end
    end)
    UpdateList()
end

CreatePvpList()
